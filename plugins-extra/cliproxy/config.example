url=http://127.0.0.1:8317
key_env=CLIPROXY_API_KEY        # env var holding the proxy's client key
# key=...                       # or the client key itself (this file stays mode 600)
mgmt_key_env=CLIPROXY_MGMT_KEY  # env var holding the management key (merged usage)
# mgmt_key=...                  # or the management key itself
# start_cmd=...                 # start/stop commands when brew has no cliproxyapi (run in this folder)
# stop_cmd=...
# proxy_config=...              # the proxy's config.yaml that setup edits (relative = in this folder)
mode=failover                   # failover: one account until it is limited, then the next (same chat, no restart)
                                # wrr: weighted round-robin, chats spread by weight, each chat stays on one
                                # switch with: ai plugin do cliproxy mode-wrr (or mode-failover), or TUI a
# order=...                     # failover order, auth file names (set by the move up / down actions)
