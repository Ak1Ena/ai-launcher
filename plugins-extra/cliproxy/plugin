#!/usr/bin/env bash
# cliproxy plugin for ai-launcher: one "all accounts" Claude Code channel through a local CLIProxyAPI.
# Protocol: plugin rows | actions | menu | do <start|stop|affinity|apply|on.<idx>|off.<idx>|wup.<idx>|wdown.<idx>|link|link.<kind>-<name>> | launch all [args...] | launch link | statusline | agents   (see the README "Plugins")
# API facts: docs/superpowers/notes/cliproxyapi.md. Never prints a key.
D=${AI_PLUGIN_DIR:-$(cd "$(dirname "$0")" && pwd)}
CONF=$D/config CACHE=$D/cache TAB=$(printf '\t')
DOWN='proxy not running — start: brew services start cliproxyapi'
has() { command -v "$1" >/dev/null 2>&1; }

# ── config: key=value lines, never sourced ──
[ -f "$CONF" ] || { (umask 077; cp "$D/config.example" "$CONF" 2>/dev/null || echo 'url=http://127.0.0.1:8317' > "$CONF"); chmod 600 "$CONF"; }
url= key= key_env=CLIPROXY_API_KEY mgmt_key= mgmt_key_env=CLIPROXY_MGMT_KEY start_cmd= stop_cmd=
while IFS= read -r l || [ -n "$l" ]; do
  l=${l%$'\r'}
  case $l in '#'*) continue ;; *=*) ;; *) continue ;; esac
  k=${l%%=*} v=${l#*=}; v=${v%% #*}; v=${v%%"$TAB"#*}
  while case $v in *' '|*"$TAB") true ;; *) false ;; esac; do v=${v%?}; done
  case $k in url|key|key_env|mgmt_key|mgmt_key_env|start_cmd|stop_cmd) eval "$k=\$v" ;; esac
done < "$CONF"
url=${url:-http://127.0.0.1:8317}; url=${url%/}
envname() { case $1 in ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;; esac; }   # only a valid name reaches eval
[ -n "$key" ] || ! envname "$key_env" || eval "key=\${$key_env:-}"
[ -n "$mgmt_key" ] || ! envname "$mgmt_key_env" || eval "mgmt_key=\${$mgmt_key_env:-}"

nokey() { echo "no key: set ${key_env:-CLIPROXY_API_KEY} or key= in $CONF"; }
# one probe, 1 s (CLIPROXY_PROBE_SECS: test override). Any HTTP answer means up.
up() {
  if has curl; then curl -s -m "${CLIPROXY_PROBE_SECS:-1}" -o /dev/null "$url/"; return; fi
  local hp=${url#*://} host port; hp=${hp%%/*}; host=${hp%:*}; port=${hp##*:}
  [ "$host" = "$hp" ] && case $url in https*) port=443 ;; *) port=80 ;; esac
  # shortcut: no 1 s cap without curl; fine for localhost (refused at once), a remote url can hang up to the core's 2 s
  (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null
}
# curl with the key in a config read from stdin, never on the command line.
# Prints the body, then the HTTP code as the last line.
kcurl() {
  local k=$1; shift; k=${k//\\/\\\\}; k=${k//\"/\\\"}
  printf 'header = "Authorization: Bearer %s"\n' "$k" | curl -s -K - -w '\n%{http_code}' "$@"
}
hc() { case $1 in ''|000) echo 'no answer' ;; *) echo "HTTP $1" ;; esac; }
# jq helpers: clean drops control chars from proxy-supplied text (no ESC, no forged row lines)
JQDEF='def clean: tostring | gsub("[[:cntrl:]]"; "");
  def strat: (. // "" | clean | ascii_downcase) as $s
    | if $s == "" or $s == "rr" or $s == "roundrobin" then "round-robin"
      elif $s == "wrr" or $s == "weightedroundrobin" then "weighted-round-robin"
      elif $s == "ff" or $s == "fillfirst" then "fill-first" else $s end;
  def aid: .auth_index // "" | clean | gsub("[^A-Za-z0-9._-]"; "");
  def who: .email // .account // .name // .id // "?" | clean;
  def wt: .weight // 1 | (tonumber? // 1) | floor | if . < 0 then 0 elif . > 99 then 99 else . end;
  def pri: .priority // 0 | (tonumber? // 0);
  def accts: [.files[]? | select((.provider // .type // "") | ascii_downcase | test("^(claude|codex)$"))
    | {i: aid, n: (.name // .id // "" | clean), e: who, w: wt, d: (.disabled == true), p: (.provider // .type | ascii_downcase), r: pri}
    | select(.i != "" and .n != "")] | sort_by(.n)[] | [.i, .n, .e, .w, .d, .p, .r] | @tsv;
  # every proxy file, any provider: lower-case name TAB lower-case email field ("" when none), for link
  def names: .files[]? | [(.name // .id // "" | clean | ascii_downcase), (.email | if type == "string" then clean | ascii_downcase else "" end)] | @tsv;
  # recent_requests: 10-minute buckets, oldest first; a list of {time, success, failed}, or (v0) a string:
  # a header "[20]{failed:int,success:int,time:string}" then one "failed,success,HH:MM-HH:MM" line per bucket -> [{s, t}]
  def rr: if type == "array" then [.[] | {s: (.success? | tonumber? // 0), t: .time?}]
    elif type == "string" then split("\n") as $l
      | ($l[0] | (capture("\\{(?<f>[^}]*)\\}").f // "") | split(",") | map(split(":")[0] | gsub("\\s"; ""))) as $h
      | (($h | index("success")) // 1) as $i | (($h | index("time")) // 2) as $j
      | [$l[1:][] | gsub("^\\s+|\\s+$"; "") | select(. != "") | split(",") | {s: (.[$i] | tonumber? // 0), t: .[$j]}]
    else [] end;
  # minutes since a bucket ended (negative: still running): "HH:MM-HH:MM" / "HH:MM" (local time, across midnight), epoch or ISO start
  def hm: split(":") | (.[0] | tonumber) * 60 + (.[1] | tonumber);
  def mago($e; $nowm): ((($nowm - $e) % 1440) + 1440) % 1440 | if . >= 1430 then . - 1440 else . end;
  def bage($now; $nowm): if type == "number" then ($now - (if . > 1e12 then . / 1000 else . end) - 600) / 60
    elif type != "string" then null
    elif test("^[0-9]{1,2}:[0-9]{2}-[0-9]{1,2}:[0-9]{2}$") then mago(split("-")[1] | hm; $nowm)
    elif test("^[0-9]{1,2}:[0-9]{2}$") then mago((hm + 10) % 1440; $nowm)
    else (try (sub("\\.[0-9]+"; "") | sub("(\\+00:00|Z)$"; "Z") | fromdateiso8601) catch null) | if . == null then null else ($now - . - 600) / 60 end end;
  # per provider, the enabled account with a success in the newest bucket that ended at most 20 min ago (ties: most successes): provider TAB email
  def inuse($now; $nowm): [.files[]? | select(.disabled != true) | {p: (.provider // .type // "" | clean | ascii_downcase), e: who} as $f
      | (.recent_requests | rr[]) | select(.s > 0) | (.t | bage($now; $nowm)) as $a | select($a != null and $a >= -10 and $a <= 20) | $f + {s, a: $a}]
    | map(select(.p != "")) | group_by(.p)[] | sort_by([.a, -.s])[0] | [.p, .e] | @tsv;
  # provider of a model id, as the proxy names its logins: gpt -> codex, else the prefix (claude, gemini, ...)
  def mprov: split("-")[0] | ascii_downcase | if . == "gpt" then "codex" else . end;'

# ── usage cache: line 1 = fetch time, then detail lines ──
refresh() {
  local out code base=v8 cred=credentials call=requests/api-call creds q f line ai prov acct req
  # routing: strategy, affinity, subagents (absent = true), disable-cooling, ttl ("-" = empty); no file = unknown (v0, refused, no answer)
  out=$(kcurl "$mgmt_key" -m 5 "$url/v8/management/config/routing")
  if [ "${out##*$'\n'}" = 200 ] && printf '%s\n' "${out%$'\n'*}" | jq -r "$JQDEF"'[(.strategy | strat), (.["session-affinity"] == true),
      (.["session-affinity-subagents"] != false), (.cooldown["disable-cooling"]? == true),
      (.["session-affinity-ttl"] // "" | clean | if . == "" then "-" else . end)] | @tsv' > "$CACHE/routing.$$" 2>/dev/null; then
    mv "$CACHE/routing.$$" "$CACHE/routing"
  else rm -f "$CACHE/routing" "$CACHE/routing.$$"; fi
  out=$(kcurl "$mgmt_key" -m 10 "$url/v8/management/credentials"); code=${out##*$'\n'}
  [ "$code" = 000 ] && code=
  if [ "$code" = 404 ]; then
    base=v0 cred=auth-files call=api-call
    out=$(kcurl "$mgmt_key" -m 10 "$url/v0/management/auth-files"); code=${out##*$'\n'}
    [ "$code" = 000 ] && code=
  fi
  find "$CACHE" -maxdepth 1 -type f -name '*.[0-9]*' -mmin +5 -exec rm -f {} + 2>/dev/null   # left by a killed refresh
  creds=$CACHE/creds.$$ q=$CACHE/quota.$$ f=$CACHE/usage.$$
  printf '%s\n' "${out%$'\n'*}" > "$creds"; : > "$q"
  if [ "$code" != 200 ] || ! jq -e '.files|type=="array"' "$creds" >/dev/null 2>&1; then
    case $code in
      401|403) line="usage: management API refused ($code)" ;;
      404) line="usage: management API off (set remote-management secret-key in the proxy config)" ;;
      *) line="usage: management API unavailable (${code:-no answer})" ;;
    esac
    rm -f "$CACHE/accts" "$CACHE/names" "$CACHE/inuse"
    { date +%s; printf '  \t%s\n' "$line"; } > "$f"; mv "$f" "$CACHE/usage"; return
  fi
  # accounts cache: <idx> TAB <name> TAB <email> TAB <weight> TAB <disabled> TAB <provider> TAB <priority> per claude / codex account, by name
  jq -r "$JQDEF"'accts' "$creds" > "$CACHE/accts.$$" 2>/dev/null && mv "$CACHE/accts.$$" "$CACHE/accts"
  jq -r "$JQDEF"'names' "$creds" > "$CACHE/names.$$" 2>/dev/null && mv "$CACHE/names.$$" "$CACHE/names"
  jq -r --argjson now "$(date +%s)" --argjson nowm "$(date '+%H %M' | awk '{ print $1 * 60 + $2 }')" "$JQDEF"'inuse($now; $nowm)' "$creds" > "$CACHE/inuse.$$" 2>/dev/null && mv "$CACHE/inuse.$$" "$CACHE/inuse"
  # each enabled claude / codex login: its provider's own usage endpoint through the proxy (as the Management Center does)
  jq -r '.files[] | select((.disabled != true) and ((.provider // .type // "") | ascii_downcase | test("^(claude|codex)$")))
    | [.auth_index, (.provider // .type | ascii_downcase), (.id_token.chatgpt_account_id? // "")] | @tsv' "$creds" 2>/dev/null |
  while IFS="$TAB" read -r ai prov acct; do
    [ -n "$ai" ] || continue
    jq -n --arg ai "$ai" --arg p "$prov" --arg acct "$acct" '{auth_index: $ai, method: "GET", data: ""} +
      if $p == "claude" then {url: "https://api.anthropic.com/api/oauth/usage", header: {"Authorization": "Bearer $TOKEN$",
        "Content-Type": "application/json", "anthropic-beta": "oauth-2025-04-20", "User-Agent": "claude-cli/2.1.280 (external, cli)"}}
      else {url: "https://chatgpt.com/backend-api/wham/usage", header: ({"Authorization": "Bearer $TOKEN$",
        "Content-Type": "application/json", "User-Agent": "codex-tui/0.149.1"} + if $acct != "" then {"Chatgpt-Account-Id": $acct} else {} end)} end' > "$CACHE/req.$$"
    out=$(kcurl "$mgmt_key" -m 20 -X POST -H 'Content-Type: application/json' --data-binary "@$CACHE/req.$$" "$url/$base/management/$call")
    [ "${out##*$'\n'}" = 200 ] || continue
    printf '%s\n' "${out%$'\n'*}" | jq -c --arg p "$prov" --arg ai "$ai" 'select(.status_code == 200) | {p: $p, ai: $ai, q: (.body | fromjson)}' >> "$q" 2>/dev/null
  done
  local models=
  [ -n "$key" ] && models=$(kcurl "$key" -m 5 "$url/v1/models") && [ "${models##*$'\n'}" = 200 ] &&
    models=$(printf '%s\n' "${models%$'\n'*}" | jq -r "$JQDEF"'[.data[]?.id | strings | clean] | join(", ") | if length > 100 then .[:99] + "…" else . end' 2>/dev/null) || models=
  {
    date +%s
    jq -rn --argjson now "$(date +%s)" --slurpfile c "$creds" --slurpfile q "$q" "$JQDEF"'
      def rep($s; $n): reduce range(0; $n) as $i (""; . + $s);
      def num: if type == "number" then . elif type == "string" then (tonumber? // null) else null end;
      def left: if type == "number" then (if . > 1e12 then . / 1000 else . end) - $now
        elif type == "string" then ((try (sub("\\.[0-9]+"; "") | sub("(\\+00:00|Z)$"; "Z") | fromdateiso8601) catch null) // (tonumber? // null))
          | if . == null then null elif . > 1e12 then . / 1000 - $now else . - $now end
        else null end;
      def in_: if . == null or . <= 0 then "" elif . >= 86400 then " ↻\(. / 86400 | floor)d"
        elif . >= 3600 then " ↻\(. / 3600 | floor)h" else " ↻\([. / 60 | floor, 1] | max)m" end;
      def bar($w; $l): ($l | map(.pct) | map(select(. != null))) as $ps
        | if ($ps | length) == 0 then empty else
          ((($ps | add) / ($ps | length)) | round) as $p | ([((($p + 5) / 10) | floor), 10] | min) as $n
          | ($l | map(.left) | map(select(. != null and . > 0)) | min) as $s
          | "\($w) \(rep("█"; $n))\(rep("░"; 10 - $n)) \(rep(" "; 3 - ($p | tostring | length)))\($p)%\($s | in_)" end;
      # claude: utilization is a percent 0-100
      def claude: [["5h", .five_hour], ["wk", .seven_day]][] | select(.[1] | type == "object")
        | {w: .[0], pct: (.[1].utilization | num), left: (.[1].resets_at | left)};
      # codex: 5h vs weekly by limit_window_seconds, else primary = 5h, secondary = weekly
      def codex: (.rate_limit // .rateLimit // {}) as $r
        | [["5h", ($r.primary_window // $r.primaryWindow)], ["wk", ($r.secondary_window // $r.secondaryWindow)]][]
        | .[0] as $pos | .[1] | select(type == "object")
        | (.limit_window_seconds // .limitWindowSeconds | num) as $sec
        | {w: (if $sec == null then $pos elif $sec < 86400 then "5h" else "wk" end),
           pct: ((.used_percent // .usedPercent | num) // (if ($r.limit_reached // $r.limitReached) == true or $r.allowed == false then 100 else null end)),
           left: (((.reset_at // .resetAt) | left) // (.reset_after_seconds // .resetAfterSeconds | num))};
      ([$q[] | .p as $p | .ai as $ai | .q | {p: $p, ai: $ai, ws: [if $p == "claude" then claude else codex end]}]) as $quota
      # every enabled login of a provider limited (5h/weekly at 100%, or cooling down / unavailable) -> one warning line
      | def allout($p; $label):
          [$c[0].files[] | select((.disabled != true) and ((.provider // .type // "") | ascii_downcase) == $p)] as $fs
          | if ($fs | length) == 0 then empty else
            [$fs[] | . as $f
              | [$quota[] | select(.p == $p and .ai == ($f.auth_index | tostring)) | .ws[] | select(.pct != null and .pct >= 100) | .left] as $ql
              | [($f.cooldowns // [])[]? | (.remaining_seconds | num)] as $cl
              | if $f.unavailable == true or ($cl | length) > 0 or ($ql | length) > 0
                then {r: (($ql + $cl) | map(select(. != null)) | max)} else empty end] as $L
            | if ($L | length) == ($fs | length) then "  \t⚠ all \($label) accounts limited"
                + ([$L[].r | select(. != null and . > 0)] | min | if . == null then "" else " · next reset " + (in_ | ltrimstr(" ")) end)
              else empty end end;
      allout("claude"; "Claude"), allout("codex"; "Codex"),
      ($c[0].files | map(. + {p: ((.provider // .type // "?") | clean | ascii_downcase)}) | group_by(.p)[]
      | .[0].p as $p | length as $n
      | ([$quota[] | select(.p == $p) | .ws[]]) as $ws
      | [$p] + ([bar("5h"; [$ws[] | select(.w == "5h")]), bar("wk"; [$ws[] | select(.w == "wk")])])
        + ["\($n) acct\(if $n == 1 then "" else "s" end)",
           "\(map(.success | num // 0) | add) req", "\(map(.failed | num // 0) | add) failed"]
      | "  \t" + join(" · "))' 2>/dev/null
    [ -n "$models" ] && printf '  \tmodels: %s\n' "$models"
  } > "$f"
  mv "$f" "$CACHE/usage"
}

usage() {
  if ! has curl; then printf '  \tusage needs curl\n'; return; fi
  if ! has jq; then printf '  \tusage needs jq\n'; return; fi
  [ -n "$mgmt_key" ] || { printf '  \tusage: set %s or mgmt_key= in config\n' "${mgmt_key_env:-CLIPROXY_MGMT_KEY}"; return; }
  mkdir -p "$CACHE" && chmod 700 "$CACHE"
  # a lock left by a killed refresh
  [ -d "$CACHE/lock" ] && [ -n "$(find "$CACHE/lock" -maxdepth 0 -mmin +5 2>/dev/null)" ] && rm -rf "$CACHE/lock"
  local ts=; [ -f "$CACHE/usage" ] && ts=$(head -1 "$CACHE/usage")
  case $ts in ''|*[!0-9]*) ts=0 ;; esac
  if [ -f "$CACHE/usage" ]; then tail -n +2 "$CACHE/usage" | grep -vF '⚠ all '; else printf '  \tloading usage…\n'; fi
  [ $(( $(date +%s) - ts )) -lt 60 ] && return
  mkdir "$CACHE/lock" 2>/dev/null || return 0   # a refresh is already running
  # the job gets no stdout, so the caller is never held open while it runs
  { refresh; rm -rf "$CACHE/lock" "$CACHE"/*.$$; } </dev/null >/dev/null 2>&1 &
}

# routing cache -> aff_state: on | off | unknown, r_strategy, r_cool, r_ttl, and wrr_ok: yes | no | unknown
# wrr_ok no: the proxy is not on weighted-round-robin, or an account has a priority (weights count only in the top tier)
routing() {
  aff_state=unknown r_strategy= r_cool= r_ttl= wrr_ok=unknown
  [ -n "$mgmt_key" ] && [ -f "$CACHE/routing" ] || return 0
  local a s
  IFS="$TAB" read -r r_strategy a s r_cool r_ttl < "$CACHE/routing"
  [ "$a" = true ] && [ "$s" = true ] && aff_state=on || aff_state=off
  wrr_ok=yes
  [ "$r_strategy" = weighted-round-robin ] || wrr_ok=no
  [ -f "$CACHE/accts" ] && awk -F "$TAB" '$7 + 0 != 0 { f = 1 } END { exit !f }' "$CACHE/accts" && wrr_ok=no
  return 0
}
wl() { [ "$1" -gt 0 ] && echo "$1" || echo off; }

# GET the v8 routing config: sets out (body) and code
getrouting() {
  out=$(kcurl "$mgmt_key" -m 5 "$url/v8/management/config/routing"); code=${out##*$'\n'}
  out=${out%$'\n'*}
}
# affinity keys for a PATCH body; ttl 1h when the proxy has none
affkeys() {
  local ttl; ttl=$(printf '%s\n' "$out" | jq -r '.["session-affinity-ttl"] // "" | tostring' 2>/dev/null)
  printf '"session-affinity":true,"session-affinity-subagents":true'
  [ -n "$ttl" ] || printf ',"session-affinity-ttl":"1h"'
}
# set the proxy to weighted-round-robin: one v8 config PATCH merge (v8 404 -> v0 strategy PUT only), then every priority 0
apply() {
  has curl && has jq || { echo "proxy not changed (needs curl and jq)"; return 1; }
  rm -f "$CACHE/usage" "$CACHE/routing"
  getrouting
  if [ "$code" = 200 ]; then
    out=$(kcurl "$mgmt_key" -m 10 -X PATCH -H 'Content-Type: application/json' --data-binary "{\"routing\":{\"strategy\":\"weighted-round-robin\",$(affkeys)}}" "$url/v8/management/config"); code=${out##*$'\n'}
  elif [ "$code" = 404 ]; then
    out=$(kcurl "$mgmt_key" -m 10 -X PUT -H 'Content-Type: application/json' --data-binary '{"value":"weighted-round-robin"}' "$url/v0/management/routing/strategy"); code=${out##*$'\n'}
  fi
  if [ "$code" != 200 ]; then echo "could not apply weighted round-robin ($(hc "$code"))"; return 1; fi
  priorities || return 1
  echo "proxy now uses weighted round-robin: chats spread across accounts by weight, each chat stays on one"
}

# ── per-account changes: always on the live list, through the management API ──
mpatch() {  # mpatch fields|status <json>: v8 credentials/<x>, v0 auth-files/<x> on 404; sets code
  out=$(kcurl "$mgmt_key" -m 10 -X PATCH -H 'Content-Type: application/json' --data-binary "$2" "$url/v8/management/credentials/$1"); code=${out##*$'\n'}
  [ "$code" = 404 ] && { out=$(kcurl "$mgmt_key" -m 10 -X PATCH -H 'Content-Type: application/json' --data-binary "$2" "$url/v0/management/auth-files/$1"); code=${out##*$'\n'}; }
  [ "$code" = 200 ]
}
fetchaccts() {  # the live list into the accounts cache
  out=$(kcurl "$mgmt_key" -m 10 "$url/v8/management/credentials"); code=${out##*$'\n'}
  [ "$code" = 404 ] && { out=$(kcurl "$mgmt_key" -m 10 "$url/v0/management/auth-files"); code=${out##*$'\n'}; }
  [ "$code" = 200 ] || { echo "could not read the accounts ($(hc "$code"))"; return 1; }
  mkdir -p "$CACHE" && chmod 700 "$CACHE"
  printf '%s\n' "${out%$'\n'*}" | jq -r "$JQDEF"'accts' > "$CACHE/accts.$$" 2>/dev/null && mv "$CACHE/accts.$$" "$CACHE/accts"
  printf '%s\n' "${out%$'\n'*}" | jq -r "$JQDEF"'names' > "$CACHE/names.$$" 2>/dev/null && mv "$CACHE/names.$$" "$CACHE/names"
}
# every priority 0: weighted-round-robin weights only the top priority tier;
# weight 0 is never picked, so an account switched on gets at least 1 (off is the on/off toggle)
priorities() {
  fetchaccts || return 1
  local i nm e w d rest
  while IFS="$TAB" read -r i nm e w d rest; do
    [ -n "$nm" ] || continue
    case $w in ""|*[!0-9]*) w=1 ;; esac; [ "$d" = true ] && w=1
    mpatch fields "$(jq -cn --arg n "$nm" --argjson w "$w" '{name: $n, priority: 0} + (if $w < 1 then {weight: 1} else {} end)')" ||
      { echo "could not clear the account priorities ($(hc "$code"))"; return 1; }
  done < "$CACHE/accts"
  fetchaccts >/dev/null
}
# acct <idx>: needs the key, reads the live list, sets i nm e w d or fails
acct() {
  [ -n "$mgmt_key" ] || { echo 'needs the management key'; return 1; }
  has curl && has jq || { echo 'needs curl and jq'; return 1; }
  case $1 in ''|*[!A-Za-z0-9._-]*) echo "unknown account: $1"; return 1 ;; esac
  fetchaccts || return 1
  local l; l=$(awk -F "$TAB" -v id="$1" '$1 == id { print; exit }' "$CACHE/accts")
  [ -n "$l" ] || { echo "unknown account: $1"; return 1; }
  IFS="$TAB" read -r i nm e w d _ <<EOF
$l
EOF
}
setweight() {
  acct "$2" || return 1
  local n=$((w - 1)); [ "$1" = up ] && n=$((w + 1))
  [ $n -ge 0 ] && [ $n -le 99 ] || { echo "$e: weight stays $(wl "$w") (range 0 to 99)"; return 1; }
  mpatch fields "$(jq -cn --arg n "$nm" --argjson w "$n" '{name: $n, weight: $w}')" || { echo "could not set the weight of $e ($(hc "$code"))"; return 1; }
  fetchaccts >/dev/null
  if [ $n = 0 ]; then echo "$e: weight 0, off (never picked)"; else echo "$e: weight $n"; fi
}
setuse() {
  acct "$2" || return 1
  mpatch status "$(jq -cn --arg n "$nm" --argjson d "$([ "$1" = on ] && echo false || echo true)" '{name: $n, disabled: $d}')" ||
    { echo "could not change $e ($(hc "$code"))"; return 1; }
  fetchaccts >/dev/null
  if [ "$1" = on ]; then echo "$e: used"; else echo "$e: not used"; fi
}

# ── link: copy a launcher account's own login (cla / Codex) into the proxy, no browser ──
okmail() { case $1 in *@*) case $1 in *[!A-Za-z0-9._%+@-]*) return 1 ;; esac ;; *) return 1 ;; esac; }
# launcher accounts with a known email: kind TAB id TAB email TAB home
laccts() {
  has jq || return 0
  local f e h a c pf=${AI_PROVIDERS:-$HOME/.config/ai-launcher/providers}
  set -- "${CLA_ROOT:-$HOME/.claude-accounts}"/*/.claude.json
  [ -f "$1" ] && jq -r '[input_filename, (.oauthAccount.emailAddress // "")] | @tsv' "$@" 2>/dev/null |
    while IFS="$TAB" read -r f e; do
      h=${f%/.claude.json}; a=$(printf '%s' "${h##*/}" | tr -cd 'A-Za-z0-9._-')
      okmail "$e" && printf 'claude\tclaude-%s\t%s\t%s\n' "$a" "$e" "$h"
    done
  [ -f "$pf" ] || return 0
  while IFS="$TAB" read -r a c _; do   # providers that run codex (the same rule as setup)
    [ "$(printf '%s\n' "$c" | awk '{for (i = 1; i <= NF; i++) if ($i !~ /^[A-Za-z_][A-Za-z0-9_]*=/) {n = split($i, p, "/"); print p[n]; exit}}')" = codex ] || continue
    case $a in ''|*[!A-Za-z0-9._-]*) continue ;; esac
    h=${AI_ACCOUNTS:-$HOME/.ai-accounts}/codex/$a; [ "$a" = codex ] && h=${CODEX_HOME:-$HOME/.codex}
    e=$(jq -r "$JWT"'.tokens.id_token // empty | jwt | .email // empty' "$h/auth.json" 2>/dev/null)
    okmail "$e" && printf 'codex\tcodex-%s\t%s\t%s\n' "$a" "$e" "$h"
  done < "$pf"
}
JWT='def jwt: split(".")[1] // "" | gsub("-"; "+") | gsub("_"; "/") | . + ([range(0; (4 - length % 4) % 4)] | map("=") | join("")) | @base64d | fromjson;'
# launcher accounts whose email no proxy file has in its email field (any case); one per email
unlinked() {
  [ -f "$CACHE/names" ] || return 0
  laccts | awk -F "$TAB" 'FILENAME == ARGV[1] { if ($2 != "") p[$2] = 1; next } { e = tolower($3) } !(e in p) && !s[e]++' "$CACHE/names" -
}
# Keychain service of a Claude Code config dir: "Claude Code-credentials-" + sha256(CLAUDE_CONFIG_DIR)[0:8],
# as claude 2.1.311 builds it (kW(): no suffix only when CLAUDE_CONFIG_DIR is unset); account = $USER
ksvc() {
  local h; if has shasum; then h=$(printf '%s' "$1" | shasum -a 256); else h=$(printf '%s' "$1" | sha256sum); fi
  printf 'Claude Code-credentials-%s' "${h:0:8}"
}
kuser() { local u=${USER:-$(id -un 2>/dev/null)}; case $u in ''|*[!A-Za-z0-9._-]*) u=claude-code-user ;; esac; printf '%s' "$u"; }
# link1 <kind> <email> <home>: upload that login as a proxy auth file. Tokens only pass through pipes and one 600 temp file.
link1() {
  local t=$CACHE/link.$$ s=
  rm -f "$t"
  if [ "$1" = claude ]; then
    has security && s=$(security find-generic-password -a "$(kuser)" -w -s "$(ksvc "$3")" 2>/dev/null)
    case $s in '{'*|'') ;; *[!0-9a-fA-F]*) s= ;; *) s=$(printf '%s' "$s" | xxd -r -p 2>/dev/null) ;; esac   # -w prints hex for some items
    [ -n "$s" ] || s=$(cat "$3/.credentials.json" 2>/dev/null)   # Linux, or claude's plaintext fallback
    ( umask 077; printf '%s' "$s" | jq -c --arg e "$2" '.claudeAiOauth // empty | select(.accessToken and .refreshToken)
      | {type: "claude", access_token: .accessToken, refresh_token: .refreshToken, id_token: "", email: $e,
         expired: ((.expiresAt // 0) / 1000 | floor | todate), last_refresh: (now | floor | todate)}' > "$t" 2>/dev/null )
  else
    ( umask 077; jq -c --arg e "$2" "$JWT"'.tokens // empty | select(.access_token and .refresh_token)
      | {type: "codex", id_token: (.id_token // ""), access_token, refresh_token, account_id: (.account_id // ""), email: $e,
         expired: ((try (.access_token | jwt | .exp | todate) catch null) // ""), last_refresh: (now | floor | todate)}' "$3/auth.json" > "$t" 2>/dev/null )
  fi
  s=
  [ -s "$t" ] || { rm -f "$t"; echo "skipped $2: no saved login found"; return 1; }
  # the proxy replaces a file of the same name: never upload over one
  if cut -f1 "$CACHE/names" | grep -qxF -- "$(printf '%s' "$1-$2.json" | tr 'A-Z' 'a-z')"; then
    rm -f "$t"; echo "skipped $2: a proxy file named $1-$2.json already exists"; return 1
  fi
  out=$(kcurl "$mgmt_key" -m 10 -F "file=@$t;type=application/json;filename=$1-$2.json" "$url/v0/management/auth-files"); code=${out##*$'\n'}
  rm -f "$t"
  # the proxy's own error text (never a token: the body is its message), one line, short
  [ "$code" = 200 ] || { echo "skipped $2: the proxy refused it ($(hc "$code")): $(printf '%s' "${out%$'\n'*}" | jq -r '.error // .message // empty' 2>/dev/null | tr -d '\000-\037\177' | cut -c1-160)"; return 1; }
  echo "linked $2"
}
# link [id]: every launcher account not in the proxy, or the one with that id
link() {
  [ -n "$mgmt_key" ] || { echo 'needs the management key'; return 1; }
  has curl && has jq || { echo 'needs curl and jq'; return 1; }
  fetchaccts || return 1
  trap 'rm -f "$CACHE/link.$$"' EXIT; trap 'exit 1' INT TERM HUP
  # shortcut: a Keychain prompt with no tty blocks until answered (do: 30 s limit); the launch row has a tty
  local k id e h n=0 bad=0
  while IFS="$TAB" read -r k id e h; do
    [ -n "$id" ] || continue
    [ -z "$1" ] || [ "$1" = "$id" ] || continue
    n=$((n + 1)); link1 "$k" "$e" "$h" || bad=1
  done <<EOF
$(unlinked)
EOF
  if [ $n = 0 ]; then
    if [ -n "$1" ]; then echo "unknown or already linked: $1"; return 1; fi
    echo 'nothing to link: every launcher account is in the proxy'; return 0
  fi
  rm -f "$CACHE/usage"; fetchaccts >/dev/null
  return $bad
}

# model sub-agents for claude --agents (its Agent tool takes only claude model names; an agent definition takes any):
# every model the proxy lists (no image models), live in 2 s and saved to cache/agents.json, else the saved copy. Prints the JSON or nothing.
agents() {
  has jq || return 0
  local m j
  if has curl && [ -n "$key" ]; then
    m=$(kcurl "$key" -m 2 "$url/v1/models")
    if [ "${m##*$'\n'}" = 200 ]; then
      j=$(printf '%s\n' "${m%$'\n'*}" | jq -c "$JQDEF"'[.data[]? | select(.id | type == "string" and test("^[A-Za-z0-9._:-]+$") and (test("image") | not))
          | {id, n: (.id | ascii_downcase | gsub("[^a-z0-9-]"; "-") | gsub("-+"; "-") | gsub("^-|-$"; "")),
             o: ((.owned_by // "" | clean) as $ob | if $ob != "" then $ob else .id | mprov | {claude: "Claude", codex: "Codex", gemini: "Gemini"}[.] // . end)}
          | select(.n != "")] | unique_by(.n)   # one agent per name, the first model keeps it
        | if length == 0 then empty else map(.id as $m | {key: .n, value: {description: "Sub-agent on \($m) (\(.o) account via cliproxy). Use when a task should run on \($m).",
          prompt: "You are a sub-agent running on \($m). Do the task you are given and report the result.", model: $m}}) | from_entries end' 2>/dev/null)
      mkdir -p "$CACHE" && chmod 700 "$CACHE"
      if [ -n "$j" ]; then printf '%s\n' "$j" > "$CACHE/agents.json.$$" && mv "$CACHE/agents.json.$$" "$CACHE/agents.json"
      else rm -f "$CACHE/agents.json"; fi
      [ -z "$j" ] || printf '%s\n' "$j"; return 0
    fi
  fi
  [ -f "$CACHE/agents.json" ] && cat "$CACHE/agents.json"
  return 0
}

brew_has() { has brew && [ -d "$(brew --prefix 2>/dev/null)/opt/cliproxyapi" ]; }

case ${1:-} in
  rows)
    routing
    printf 'section\tCLIPROXY · all accounts\n'
    printf 'all\tClaude Code · all accounts\t'
    if [ -z "$key" ]; then nokey; exit 0; fi
    up || { echo "$DOWN"; exit 0; }
    warn=; [ -f "$CACHE/usage" ] && warn=$(tail -n +2 "$CACHE/usage" | grep -F '⚠ all ')
    case $warn in *'all Claude accounts limited'*) echo 'proxy up · Claude limited' ;; *) echo 'proxy up' ;; esac
    [ -z "$warn" ] || printf '%s\n' "$warn"
    case $aff_state in
      off) printf '  \t⚠ session affinity off: a chat can move between accounts and re-send its whole context — TUI: a, or ai plugin do cliproxy affinity\n' ;;
      on) printf '  \trouting: %s · sticky per chat%s\n' "$r_strategy" "$([ "$r_ttl" = - ] || printf ' (%s)' "$r_ttl")" ;;
    esac
    s=$r_strategy; [ "$r_cool" = true ] && s="$s (cooling off)"
    if [ $wrr_ok = no ]; then
      if [ "$r_strategy" = weighted-round-robin ]; then s='account priorities, so weights count only in the top tier'
      else s="$s, not weighted round-robin"; fi
      printf '  \t⚠ proxy uses %s — apply: TUI a, or ai plugin do cliproxy apply\n' "$s"
    fi
    if [ -n "$mgmt_key" ] && [ -f "$CACHE/accts" ]; then
      awk -F "$TAB" '{ if ($5 == "true" || $4 + 0 <= 0) printf "  \t%s  off\n", $3; else printf "  \t%s  ×%d\n", $3, $4 }' "$CACHE/accts"
      iu=$(awk -F "$TAB" '{ printf "%s%s %s", (NR > 1 ? " · " : ""), $1, $2 }' "$CACHE/inuse" 2>/dev/null)
      [ -z "$iu" ] || printf '  \tin use: %s\n' "$iu"
      nl=$(unlinked | cut -f3)
      [ -z "$nl" ] || printf '%s\n' "$nl" | sed "s/^/  $TAB/; s/\$/  not linked/"
    fi
    usage
    # a launch row: linking may need a Keychain prompt, and launch has a tty
    [ -z "${nl:-}" ] || printf 'link\t+ Link launcher accounts\t%s not linked\n' "$(printf '%s\n' "$nl" | grep -c .)" ;;
  menu)   # the TUI's tabbed window, from the same state and ids as actions (README "Plugins": menu)
    printf 'tab\tlist\tActions\n'
    if brew_has || [ -n "$start_cmd" ]; then printf 'item\tstart\tstart proxy\n'; fi
    if brew_has || [ -n "$stop_cmd" ]; then printf 'item\tstop\tstop proxy\n'; fi
    routing
    [ $wrr_ok = no ] && printf 'item\tapply\tApply weighted round-robin to the proxy\n'
    [ -n "$mgmt_key" ] && [ "$aff_state" != on ] && printf 'item\taffinity\tKeep each chat on one account\n'
    nl=; [ -n "$mgmt_key" ] && [ -f "$CACHE/accts" ] && nl=$(unlinked)
    [ -z "$nl" ] || printf 'item\tlink\tLink all launcher accounts\n'
    if [ -n "$mgmt_key" ] && [ -f "$CACHE/accts" ]; then
      printf 'tab\tchecklist\tAccounts\tweight\n'
      # row key label checked n note on-id off-id dec-id inc-id
      awk -F "$TAB" '{ printf "row\t%s\t%s\t%d\t%d\t%s\ton.%s\toff.%s\twdown.%s\twup.%s\n", $1, $3, ($5 == "true") ? 0 : 1, $4, $6, $1, $1, $1, $1 }' "$CACHE/accts"
      [ -z "$nl" ] || printf '%s\n' "$nl" | awk -F "$TAB" '{ printf "row\t%s\t%s\t0\t-\t%s · not linked\tlink.%s\t-\t-\t-\n", $2, $3, $1, $2 }'
    fi
    exit 0 ;;
  actions)
    if brew_has || [ -n "$start_cmd" ]; then printf 'start\tstart proxy\n'; fi
    if brew_has || [ -n "$stop_cmd" ]; then printf 'stop\tstop proxy\n'; fi
    routing
    [ $wrr_ok = no ] && printf 'apply\tApply weighted round-robin to the proxy\n'
    [ -n "$mgmt_key" ] && [ "$aff_state" != on ] && printf 'affinity\tKeep each chat on one account\n'
    if [ -n "$mgmt_key" ] && [ -f "$CACHE/accts" ]; then
      awk -F "$TAB" '{ if ($5 == "true") { printf "on.%s\t%s: use\n", $1, $3; next }
        printf "off.%s\t%s: don'"'"'t use\n", $1, $3; w = $4 + 0
        if (w < 99) printf "wup.%s\t%s: weight %s → %s\n", $1, $3, (w > 0 ? w : "off"), w + 1
        if (w > 0) printf "wdown.%s\t%s: weight %s → %s\n", $1, $3, w, (w > 1 ? w - 1 : "off") }' "$CACHE/accts"
      unlinked | awk -F "$TAB" '{ printf "link.%s\t%s: link to proxy\n", $2, $3; n++ } END { if (n) print "link\tLink all launcher accounts" }'
    fi
    exit 0 ;;
  do)
    if [ "${2:-}" = affinity ]; then
      [ -n "$mgmt_key" ] || { echo "no management key: set ${mgmt_key_env:-CLIPROXY_MGMT_KEY} or mgmt_key= in $CONF"; exit 1; }
      has curl && has jq || { echo "affinity needs curl and jq"; exit 1; }
      getrouting
      [ "$code" = 200 ] || { echo "session affinity not available ($(hc "$code"); needs CLIProxyAPI v8)"; exit 1; }
      out=$(kcurl "$mgmt_key" -m 10 -X PATCH -H 'Content-Type: application/json' --data-binary "{\"routing\":{$(affkeys)}}" "$url/v8/management/config"); code=${out##*$'\n'}
      rm -f "$CACHE/usage" "$CACHE/routing"
      if [ "$code" = 200 ]; then echo "session affinity on: each chat now stays on one account"
      else echo "could not turn on session affinity ($(hc "$code"))"; exit 1; fi
      exit 0
    fi
    case ${2:-} in
      apply) [ -n "$mgmt_key" ] || { echo "proxy not changed (no management key)"; exit 1; }; apply; exit ;;
      on.*|off.*) setuse "${2%%.*}" "${2#*.}"; exit ;;
      wup.*) setweight up "${2#wup.}"; exit ;;
      wdown.*) setweight down "${2#wdown.}"; exit ;;
      link) link ""; exit ;;
      link.*) link "${2#link.}"; exit ;;
    esac
    case ${2:-} in start|stop) ;; *) echo "unknown action: ${2:-}"; exit 1 ;; esac
    if brew_has; then exec brew services "$2" cliproxyapi; fi
    cmd=$start_cmd; [ "$2" = stop ] && cmd=$stop_cmd
    [ -n "$cmd" ] || { echo "no $2 command: install cliproxyapi with brew or set ${2}_cmd= in $CONF"; exit 1; }
    cd "$D" && exec bash -c "$cmd" ;;   # in the plugin folder: setup's commands use paths relative to it
  launch)
    if [ "${2:-}" = link ]; then
      link ""; rc=$?
      [ -t 0 ] && { printf 'press Enter to close '; read -r _; }
      exit $rc
    fi
    [ "${2:-}" = all ] || { echo "unknown entry: ${2:-}" >&2; exit 1; }
    shift 2
    [ -n "$key" ] || { nokey >&2; exit 1; }
    up || { echo "$DOWN" >&2; exit 1; }
    unset CLAUDE_CONFIG_DIR ANTHROPIC_API_KEY CLIPROXY_MGMT_KEY
    ! envname "$mgmt_key_env" || unset "$mgmt_key_env"
    export ANTHROPIC_BASE_URL=$url ANTHROPIC_AUTH_TOKEN=$key CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
    ag=; for a; do case $a in --agents|--agents=*) ag=user; break ;; esac; done   # the user's own --agents wins
    if [ -z "$ag" ]; then ag=$(agents); [ -z "$ag" ] || set -- --agents "$ag" "$@"; fi
    # an env block in ~/.claude/settings.json (e.g. another ANTHROPIC_BASE_URL) beats the process env;
    # --settings beats user settings. A file, not an argument, so the key is never on a command line.
    cs=$D/cache/claude-settings.json
    case $url$key in *[\"\\]*) cs= ;; esac
    # no Claude model in the proxy (only other providers' accounts on): Claude Code's default and its
    # opus/sonnet/haiku/fable names would all fail, so they all point at the newest model the proxy has
    me=
    if has jq && [ -f "$CACHE/agents.json" ]; then
      ids=$(jq -r '.[].model | strings' "$CACHE/agents.json" 2>/dev/null)
      if [ -n "$ids" ] && ! printf '%s\n' "$ids" | grep -q '^claude-'; then
        dm=$(printf '%s\n' "$ids" | grep -v review | sort -V -r 2>/dev/null | head -n 1)
        [ -n "$dm" ] || dm=$(printf '%s\n' "$ids" | head -n 1)
        for v in ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_FABLE_MODEL; do
          me="$me,\"$v\":\"$dm\""
        done
      fi
    fi
    # status line: the user's own one, plus the account in use (plugin statusline)
    sl=; case $D in *[[:cntrl:]]*) ;; *) sl=$(printf '%q statusline' "$D/plugin"); sl=${sl//\\/\\\\}; sl=${sl//\"/\\\"}
      sl=",\"statusLine\":{\"type\":\"command\",\"command\":\"$sl\"}" ;; esac
    if [ -n "$cs" ] && mkdir -p "$D/cache" && (umask 077; printf '{"env":{"ANTHROPIC_BASE_URL":"%s","ANTHROPIC_AUTH_TOKEN":"%s"%s}%s}\n' "$url" "$key" "$me" "$sl" > "$cs.$$") && mv "$cs.$$" "$cs"; then
      exec claude --settings "$cs" "$@"
    fi
    [ -z "$cs" ] || rm -f "$cs.$$"
    echo "cliproxy: could not write the claude settings file: an env block in ~/.claude/settings.json may override the proxy" >&2
    exec claude "$@" ;;
  agents)   # setup: save cache/agents.json, print how many sub-agents
    n=$(agents | jq -r length 2>/dev/null); echo "${n:-0}"; exit 0 ;;
  statusline)   # Claude Code's status line in "all accounts": the user's own one, then the account in use (cache only, no network here)
    in=$(cat)
    usage >/dev/null   # a cache older than 60 s: the same background refresh as rows (its lock, never waited for)
    o= orig= pv=claude
    if has jq; then
      # --settings hides every statusLine, so the one Claude Code would have used: project local, project, user
      cwd=$(printf '%s' "$in" | jq -r '.workspace.current_dir? // .cwd? // "" | strings' 2>/dev/null)
      [ -n "$cwd" ] && [ -d "$cwd" ] || cwd=$PWD
      for f in "$cwd/.claude/settings.local.json" "$cwd/.claude/settings.json" "$HOME/.claude/settings.json"; do
        orig=$(jq -r '.statusLine.command? // empty | strings' "$f" 2>/dev/null); [ -z "$orig" ] || break
      done
      pv=$(printf '%s' "$in" | jq -r "$JQDEF"'.model.id? // "" | strings | if . == "" then "claude" else mprov end' 2>/dev/null)
    fi
    if [ -n "$orig" ] && mkdir -p "$CACHE" && chmod 700 "$CACHE"; then
      t=$CACHE/statusline.$$
      printf '%s\n' "$in" > "$t.in"
      {
        set -m   # its own process group, so a timeout also stops what it started
        (cd "$cwd" 2>/dev/null; exec bash -c "$orig") < "$t.in" > "$t" &
        p=$!; set +m; i=0
        while kill -0 $p && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done   # 2 s cap
        kill -0 $p && kill -TERM -- -$p
        wait $p
      } 2>/dev/null
      o=$(cat "$t" 2>/dev/null); rm -f "$t" "$t.in"
    fi
    e=$(awk -F "$TAB" -v p="$pv" '$1 == p { print $2; exit }' "$CACHE/inuse" 2>/dev/null)
    px=; [ -z "$e" ] || px="proxy: $pv $e"
    if [ -n "$o" ] && [ -n "$px" ]; then printf '%s · %s\n' "$o" "$px"
    elif [ -n "$o$px" ]; then printf '%s\n' "$o$px"; fi
    exit 0 ;;
  *) echo "usage: plugin rows | actions | menu | do <start|stop|affinity|apply|on.<idx>|off.<idx>|wup.<idx>|wdown.<idx>|link|link.<kind>-<name>> | launch all [args...] | launch link | statusline | agents" >&2; exit 1 ;;
esac
